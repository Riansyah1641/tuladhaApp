<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.INTERNET" />
    <application
        android:name=".App"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@drawable/logo_tuladha_white"
        android:label="@string/app_name"
        android:roundIcon="@drawable/logo_tuladha_white"
        android:supportsRtl="true"
        android:theme="@style/Theme.TuladhaApp"
        android:usesCleartextTraffic="true"
        tools:targetApi="31">
        <activity
            android:name=".ui.assesmentCourse.FeedbackCourseActivity"
            android:screenOrientation="portrait"
            android:exported="false" />
        <activity
            android:name=".ui.assesmentCourse.AssesmentCourseActivity"
            android:screenOrientation="portrait"
            android:exported="false" />
        <activity
            android:name=".ui.assesmentCourse.AssesCourseActivity"
            android:screenOrientation="portrait"
            android:exported="false" />
        <activity
            android:name=".ui.kuisCourse.QuizResultActivity"
            android:screenOrientation="portrait"
            android:exported="false"
            android:theme="@style/Theme.TuladhaApp" />
        <activity
            android:name=".ui.kuisCourse.QuizActivity"
            android:screenOrientation="portrait"
            android:exported="false" />
        <activity
            android:name=".ui.testPolaAsuh.SplashTesPolaAsuhActivity"
            android:screenOrientation="portrait"
            android:exported="false" />
        <activity
            android:name=".ui.testPolaAsuh.ResultTestActivity"
            android:screenOrientation="portrait"
            android:exported="false" />
        <activity
            android:name=".ui.testPolaAsuh.QuickStartActivity"
            android:screenOrientation="portrait"
            android:exported="false" />
        <activity
            android:name=".ui.allPremiumCourse.AllPremiumCourseActivity"
            android:screenOrientation="portrait"
            android:exported="false" />
        <activity
            android:name=".ui.profile.ProfileActivity"
            android:screenOrientation="portrait"
            android:exported="false" />
        <activity
            android:name=".ui.splashScreen.SplashScreenSlideTwooActivity"
            android:screenOrientation="portrait"
            android:exported="false" />
        <activity
            android:name=".ui.splashScreen.SplashScreenSlideThreeActivity"
            android:screenOrientation="portrait"
            android:exported="false" />
        <activity
            android:name=".ui.splashScreen.SplashScreenSlideOneActivity"
            android:screenOrientation="portrait"
            android:exported="false" />
        <activity
            android:name=".ui.splashScreen.SplashScreenActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustPan">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".ui.auth.register.RegisterActivity"
            android:screenOrientation="portrait"
            android:exported="false" />
        <activity
            android:name=".ui.auth.login.LoginActivity"
            android:screenOrientation="portrait"
            android:exported="false" />
        <activity
            android:name=".ui.detailCourse.DetailCourseActivity"
            android:screenOrientation="portrait"
            android:configChanges="orientation|screenSize|keyboardHidden|smallestScreenSize|screenLayout|layoutDirection"
            android:exported="false" />

        <activity
            android:name=".ui.main.MainActivity"
            android:screenOrientation="portrait"
            android:configChanges="orientation|screenSize|keyboardHidden|smallestScreenSize|screenLayout|layoutDirection"
            android:windowSoftInputMode="adjustPan"
            android:exported="false" />

        <meta-data
            android:name="preloaded_fonts"
            android:resource="@array/preloaded_fonts" />
    </application>

</manifest>