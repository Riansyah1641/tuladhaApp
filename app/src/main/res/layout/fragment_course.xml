<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.course.CourseFragment">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:id="@+id/tab_level"
        android:background="@color/white"
        android:paddingVertical="8dp"
        app:layout_constraintTop_toTopOf="parent"
        >
        <RadioGroup
            android:id="@+id/radio_level"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginHorizontal="24dp"
            android:checkedButton="@id/btn_parent"
            android:orientation="horizontal"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <RadioButton
                android:id="@+id/btn_parent"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/radio_btn_selector"
                android:button="@drawable/null_radio_btn"
                android:gravity="center"
                android:text="@string/level_parent"
                android:textColor="@drawable/radio_btn_text_selected" />

            <RadioButton
                android:id="@+id/btn_kids"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/radio_btn_selector"
                android:button="@drawable/null_radio_btn"
                android:gravity="center"
                android:text="Si Kecil"
                android:textColor="@drawable/radio_btn_text_selected" />

        </RadioGroup>

    </androidx.constraintlayout.widget.ConstraintLayout>




    <TextView
        android:id="@+id/tv_class_topic"
        style="@style/TextAppearance.Material3.TitleLarge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:layout_marginStart="24dp"
        android:textSize="18sp"
        android:text="@string/text_class_topic"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tab_level" />


    <ImageView
        android:id="@+id/tv_filter"
        android:layout_width="35dp"
        android:layout_marginTop="24dp"
        android:layout_height="35dp"
        android:layout_marginEnd="24dp"
        android:background="@drawable/bg_rounded_corners_color"
        android:padding="5dp"
        android:src="@drawable/ic_filter"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tab_level" />

    <ImageView
        android:id="@+id/tv_see_all"
        android:layout_width="35dp"
        android:layout_height="35dp"
        android:layout_marginTop="24dp"
        android:layout_marginEnd="8dp"
        android:background="@drawable/bg_rounded_corners_color"
        android:padding="5dp"
        android:src="@drawable/ic_see_all"
        app:layout_constraintEnd_toStartOf="@+id/tv_filter"
        app:layout_constraintTop_toBottomOf="@+id/tab_level"
        />

    <HorizontalScrollView
        android:id="@+id/sv_filter_result"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:clipToPadding="false"
        android:paddingHorizontal="24dp"
        android:scrollbars="none"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_class_topic">

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chip_group"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="visible"
            app:layout_constraintTop_toBottomOf="@id/tv_class_topic"
             />

    </HorizontalScrollView>

    <ImageView
        android:id="@+id/iv_delete"
        android:layout_width="30dp"
        android:layout_marginTop="8dp"
        android:layout_height="30dp"
        android:layout_marginEnd="24dp"
        android:visibility="gone"
        android:background="@drawable/bg_rounded_corners_color"
        android:padding="4dp"
        android:src="@drawable/ic_trash"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_filter" />

    <RadioGroup
        android:id="@+id/tab_selection"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginHorizontal="24dp"
        android:layout_marginTop="12dp"
        android:checkedButton="@id/btn_free"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/sv_filter_result">

        <RadioButton
            android:id="@+id/btn_all"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/radio_btn_selector"
            android:button="@drawable/null_radio_btn"
            android:gravity="center"
            android:text="@string/tv_btn_class_short"
            android:textColor="@drawable/radio_btn_text_selected" />
        <RadioButton
            android:id="@+id/btn_free"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/radio_btn_selector"
            android:button="@drawable/null_radio_btn"
            android:gravity="center"
            android:text="@string/tv_btn_class_normal"
            android:textColor="@drawable/radio_btn_text_selected" />

        <RadioButton
            android:id="@+id/btn_premium"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginHorizontal="8dp"
            android:layout_weight="1"
            android:background="@drawable/radio_btn_selector"
            android:button="@drawable/null_radio_btn"
            android:gravity="center"
            android:text="@string/tv_btn_class_premium"
            android:textColor="@drawable/radio_btn_text_selected" />


    </RadioGroup>

    <include
        android:id="@+id/layout_course_empty"
        layout="@layout/layout_content_course_empty"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tab_selection"
        tools:visibility="gone" />

    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@id/swipe_refresh"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tab_selection">

        <ScrollView
            android:id="@+id/sv_list_course"
            android:layout_width="match_parent"
            android:layout_height="0dp">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@id/rv_list_course"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:paddingBottom="60dp"
                    android:paddingTop="20dp"
                    android:visibility="visible"
                    app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                    tools:listitem="@layout/item_list_course" />

                <include
                    android:id="@+id/empty_data"
                    layout="@layout/item_empty_data"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:visibility="gone"
                    tools:visibility="visible"/>

            </androidx.constraintlayout.widget.ConstraintLayout>

        </ScrollView>

    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

</androidx.constraintlayout.widget.ConstraintLayout>