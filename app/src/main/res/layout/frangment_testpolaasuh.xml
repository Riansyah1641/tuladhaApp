<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.testPolaAsuh.QuickStartFragment">

    <!-- Data Binding ViewModel -->
    <data>
        <variable
            name="quickStartViewModel"
            type="com.thesis.tuladhaapp.ui.testPolaAsuh.QuickStartViewModel" />
    </data>

    <!-- Layout utama menggunakan ConstraintLayout -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/ic_background_quick_test"
        tools:context=".ui.testPolaAsuh.QuickStartFragment">

        <!-- Nomor Pertanyaan -->
        <TextView
            android:id="@+id/question_number_textView"
            style="@style/quick_start_txt_view_style"
            android:text='@{String.format("Pertanyaan %d/62", quickStartViewModel.liveIndex)}'
            android:textColor="@color/app_color_primary"
            android:layout_marginTop="32dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            tools:text="Pertanyaan 1/62" />

        <!-- Isi Pertanyaan -->
        <TextView
            android:id="@+id/question_txt"
            style="@style/quick_start_txt_view_style"
            android:text="@{quickStartViewModel.currentQuestion}"
            android:layout_marginTop="16dp"
            app:layout_constraintTop_toBottomOf="@id/question_number_textView"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:paddingHorizontal="16dp"
            tools:text="Saya sering memberikan pujian kepada anak saat dia berperilaku baik." />

        <!-- RadioGroup untuk pilihan Likert Scale -->
        <RadioGroup
            android:id="@+id/radioGroupLikert"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="24dp"
            android:layout_marginStart="32dp"
            android:layout_marginEnd="32dp"
            app:layout_constraintTop_toBottomOf="@id/question_txt"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <RadioButton
                android:id="@+id/rbNever"
                style="@style/radio_btn_style"
                android:text="Tidak Pernah"
                android:onClick="@{() -> quickStartViewModel.selectAnswer(1)}" />

            <RadioButton
                android:id="@+id/rbRarely"
                style="@style/radio_btn_style"
                android:text="Jarang"
                android:onClick="@{() -> quickStartViewModel.selectAnswer(2)}" />

            <RadioButton
                android:id="@+id/rbSometimes"
                style="@style/radio_btn_style"
                android:text="Kadang-kadang"
                android:onClick="@{() -> quickStartViewModel.selectAnswer(3)}" />

            <RadioButton
                android:id="@+id/rbOften"
                style="@style/radio_btn_style"
                android:text="Sering"
                android:onClick="@{() -> quickStartViewModel.selectAnswer(4)}" />

            <RadioButton
                android:id="@+id/rbAlways"
                style="@style/radio_btn_style"
                android:text="Selalu"
                android:onClick="@{() -> quickStartViewModel.selectAnswer(5)}" />
        </RadioGroup>

        <!-- Tombol Next -->
        <Button
            android:id="@+id/next_quick_question"
            style="@style/next_quick_question_style"
            android:text="@string/next_btn"
            android:layout_marginTop="24dp"
            android:onClick="@{() -> quickStartViewModel.nextQuestion()}"
            app:layout_constraintTop_toBottomOf="@id/radioGroupLikert"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>
